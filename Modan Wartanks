/* =====================================================================
   ネットワーク (PeerJS)
   ===================================================================== */
function makeCode() {
  const ch = 'ABCDEFGHJKMNPQRSTUVWXYZ23456789'; let s = '';
  for (let i = 0; i < 5; i++) s += ch[Math.floor(Math.random() * ch.length)];
  return s;
}
function setOnlineMsg(m) { $('onlineMsg').textContent = m || ''; }
function broadcast(m) { for (const pid in guests) { try { guests[pid].send(m); } catch (e) {} } }
function lobbyMsg() { return {t:'lobby', slots:lobby.slots, names:lobby.names, code:roomCode}; }
function broadcastLobby() { broadcast(lobbyMsg()); }
function cleanupNet() {
  leaving = true;
  clearInterval(netTimer); netTimer = null;
  for (const pid in guests) { try { guests[pid].close(); } catch (e) {} delete guests[pid]; }
  try { if (hostConn) hostConn.close(); } catch (e) {}
  try { if (peer) peer.destroy(); } catch (e) {}
  peer = null; hostConn = null; leaving = false;
}
function resetLobby() {
  SLOT_IDS.forEach(s => lobby.slots[s] = null);
  lobby.names = {p0:callsign}; nextPid = 1;
}

/* --- ホスト --- */
function createRoom() {
  if (typeof Peer === 'undefined') { setOnlineMsg('通信ライブラリを読み込めませんでした。ネット接続を確認して再読み込みしてください。'); return; }
  cleanupNet(); mode = 'host'; setOnlineMsg('ルームを作成中…'); openHostPeer(0);
}
function openHostPeer(n) {
  const code = makeCode(); const p = new Peer(PEER_PREFIX + code); peer = p;
  p.on('open', () => {
    roomCode = code; myPid = 'p0'; resetLobby(); gameRunning = false;
    $('roomCodeText').textContent = code; showScreen('lobbyScreen'); renderLobby();
  });
  p.on('connection', onGuestConnect);
  p.on('disconnected', () => { try { p.reconnect(); } catch (e) {} });
  p.on('error', e => {
    if (e.type === 'unavailable-id' && n < 5) { try { p.destroy(); } catch (x) {} openHostPeer(n + 1); }
    else if (peer === p && !roomCode) { setOnlineMsg('通信エラー: ' + e.type); mode = 'menu'; }
  });
}
function onGuestConnect(c) {
  c.on('open', () => {
    if (gameRunning) { c.send({t:'full', r:'試合中のため参加できません'}); setTimeout(() => { try { c.close(); } catch (e) {} }, 400); return; }
    if (Object.keys(guests).length >= 7) { c.send({t:'full', r:'ルームが満員です'}); setTimeout(() => { try { c.close(); } catch (e) {} }, 400); return; }
    const pid = 'p' + (nextPid++); c.pid = pid; guests[pid] = c;
    lobby.names[pid] = 'Player';
    c.send({t:'welcome', pid});
    broadcastLobby(); renderLobby();
  });
  c.on('data', m => { try { onHostMsg(c, m); } catch (e) { console.error(e); } });
  c.on('close', () => onGuestLeft(c));
  c.on('error', () => onGuestLeft(c));
}
function onGuestLeft(c) {
  const pid = c.pid; if (!pid || !guests[pid]) return;
  delete guests[pid];
  const name = lobby.names[pid] || 'Player';
  for (const s of SLOT_IDS) if (lobby.slots[s] === pid) lobby.slots[s] = null;
  delete lobby.names[pid];
  if (gameRunning) {
    tanks.forEach((t, i) => { if (t.human === pid) { t.human = null; t.pname = 'AI'; t.input = null; evOut.push(['hu', i]); } });
    toast(name + ' が切断しました(AI が引き継ぎ)');
