  if (!m || typeof m !== 'object' || !c.pid) return;
  const pid = c.pid;
  switch (m.t) {
    case 'hello': lobby.names[pid] = cleanName(m.n); if (!gameRunning) { broadcastLobby(); renderLobby(); } break;
    case 'claim': if (!gameRunning) { claim(pid, String(m.s)); broadcastLobby(); renderLobby(); } break;
    case 'in': { if (!gameRunning) break; const t = tanks.find(x => x.human === pid); if (t && t.hp > 0) t.input = sanitizeInput(m.k); break; }
    case 'act': { if (!gameRunning) break; const t = tanks.find(x => x.human === pid); if (t) applyAct(t, m.a); break; }
