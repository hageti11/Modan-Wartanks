bindHold('up', 'u'); bindHold('down', 'd'); bindHold('left', 'l'); bindHold('right', 'r');
bindHold('turretLeft', 'tl'); bindHold('turretRight', 'tr'); bindHold('fireBtn', 'f');
bindTap('smokeBtn', 'sm'); bindTap('airBtn', 'air'); bindTap('switchBtn', 'sw');
if ((window.matchMedia && matchMedia('(pointer: coarse)').matches) || 'ontouchstart' in window) document.body.classList.add('touch');
