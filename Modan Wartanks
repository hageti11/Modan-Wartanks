/* =====================================================================
   入力
   ===================================================================== */
function myTank() { return tanks.find(t => t.human === myPid) || null; }
function viewTank() {
  const m = myTank(); if (m && m.hp > 0) return m;
  const team = m ? m.team : 0;
  return tanks.find(t => t.hp > 0 && t.team === team) || m || tanks[0];
}
function buildInput() {
  let a = null; const me = myTank();
  if (mouseAim && aimScreen && me) {
    const rect = canvas.getBoundingClientRect();
    const wx = (aimScreen.x - rect.left) / rect.width * VIEW_W - camX;
    const wy = (aimScreen.y - rect.top) / rect.height * VIEW_H - camY;
    a = r2(Math.atan2(wy - me.y, wx - me.x));
  }
  return {u:!!keys.u, d:!!keys.d, l:!!keys.l, r:!!keys.r, tl:!!keys.tl, tr:!!keys.tr, f:!!keys.f, a};
}
function doAct(a) {
  if (!inGame || over) return;
  if (mode === 'client') { if (hostConn && hostConn.open) hostConn.send({t:'act', a}); }
  else applyAct(myTank(), a);
}
const KEYMAP = {ArrowUp:'u', KeyW:'u', ArrowDown:'d', KeyS:'d', ArrowLeft:'l', KeyA:'l', ArrowRight:'r', KeyD:'r', KeyQ:'tl', KeyE:'tr', Space:'f'};
window.addEventListener('keydown', e => {
  initAudio();
