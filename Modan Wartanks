    ]},
    {id:'type10', name:'10式戦車', topSpeed:72, revSpeed:72, accel:0.16, armor:{front:680, side:190, rear:60}, hp:140, color:'#3a523d', contourType:'type10', era:false, weapons:[
      {name:'10式 120mm APFSDS', speed:24.5, pen:760, decay:0.009, reload:110, damage:65, type:'ap'},
      {name:'120mm JM12A1 HEAT-MP', speed:16.0, pen:600, decay:0.0, reload:120, damage:78, type:'heat'}
    ]},
    {id:'m1a2', name:'M1A2 エイブラムス', topSpeed:65, revSpeed:34, accel:0.10, armor:{front:820, side:320, rear:100}, hp:175, color:'#6b583f', contourType:'m1a2', era:true, weapons:[
      {name:'120mm M829A3 APFSDS', speed:22.0, pen:790, decay:0.008, reload:170, damage:82, type:'ap'},
      {name:'120mm M830A1 HEAT-MP', speed:18.0, pen:620, decay:0.0, reload:170, damage:72, type:'heat'}
    ]},
    {id:'m2bradley', name:'M2A3 ブラッドレイ', topSpeed:60, revSpeed:25, accel:0.14, armor:{front:120, side:55, rear:30}, hp:100, color:'#535940', contourType:'bradley', era:true, weapons:[
      {name:'25mm M242 APDS', speed:19.0, pen:80, decay:0.025, reload:22, damage:14, type:'apds'},
      {name:'TOW-2B 対戦車誘導ミサイル', speed:7.0, pen:1050, decay:0.0, reload:320, damage:150, type:'tow'}
    ]}
  ],
  CN: [
    {id:'type99a', name:'99式A型戦車', topSpeed:73, revSpeed:30, accel:0.11, armor:{front:800, side:260, rear:90}, hp:165, color:'#314022', contourType:'type99a', era:true, weapons:[
      {name:'125mm DTC10 APFSDS', speed:23.5, pen:700, decay:0.010, reload:150, damage:70, type:'ap'},
      {name:'125mm GP128 ミサイル', speed:8.0, pen:800, decay:0.0, reload:280, damage:120, type:'tow'}
    ]},
    {id:'ztl11', name:'11式装輪突撃車', topSpeed:95, revSpeed:38, accel:0.18, armor:{front:160, side:45, rear:20}, hp:90, color:'#3c4c30', contourType:'ztl11', era:false, weapons:[
      {name:'105mm APFSDS', speed:22.0, pen:520, decay:0.016, reload:90, damage:52, type:'ap'},
      {name:'105mm HEAT', speed:16.0, pen:490, decay:0.0, reload:90, damage:58, type:'heat'}
    ]},
    {id:'vt4', name:'VT-4 主力戦車', topSpeed:68, revSpeed:28, accel:0.12, armor:{front:720, side:230, rear:70}, hp:150, color:'#455827', contourType:'vt4', era:true, weapons:[
      {name:'125mm BTA2 APFSDS', speed:23.0, pen:670, decay:0.011, reload:140, damage:68, type:'ap'},
      {name:'125mm HEAT', speed:17.0, pen:620, decay:0.0, reload:140, damage:72, type:'heat'}
    ]},
    {id:'type96a', name:'96式A型戦車', topSpeed:63, revSpeed:16, accel:0.10, armor:{front:620, side:170, rear:60}, hp:135, color:'#3d4c2c', contourType:'type96a', era:true, weapons:[
      {name:'125mm APFSDS', speed:22.5, pen:570, decay:0.014, reload:150, damage:62, type:'ap'},
      {name:'125mm HEAT', speed:17.0, pen:520, decay:0.0, reload:150, damage:68, type:'heat'}
    ]}
  ]
};
const TEAM_FACTION = ['US_JP', 'CN'];
const FACTION_LABEL = {US_JP:'日米連合部隊 (JGSDF / US Army)', CN:'中国人民解放軍 (PLAGF)'};
const SLOT_IDS = ['A0','A1','A2','A3','B0','B1','B2','B3'];
const START_Y = [260, 520, 920, 1180];
const BULLET_TYPES = ['ap', 'heat', 'apds', 'tow'];
const AIR_GUN = {name:'航空機銃', pen:120, decay:0.01, damage:14, type:'ap'};
const AIR_NAME = ['AH-64D アパッチ', '直-10 (Z-10)'];

const obstacles = [
  {x:1100, y:220, w:180, h:360}, {x:1100, y:880, w:180, h:360},
  {x:2400, y:120, w:180, h:420}, {x:2400, y:920, w:180, h:420},
  {x:3700, y:220, w:180, h:360}, {x:3700, y:880, w:180, h:360}
];

/* ---------------- 状態 ---------------- */
let mode = 'menu';            // menu | solo | host | client
let inGame = false, gameRunning = false;
let tanks = [], bullets = [], smokes = [], air = [], particles = [], popups = [], decor = [];
let over = null, overTimer = null, resultShown = false;
let evOut = [], evNet = [];
let myPid = 'p0', roomCode = '';
const lobby = {slots:{}, names:{}};
SLOT_IDS.forEach(s => lobby.slots[s] = null);
let peer = null, hostConn = null, leaving = false;
const guests = {}; let nextPid = 1;
let pingMs = 0, snapT = 0, netTimer = null, netCount = 0;
let camX = 0, camY = 0;
const keys = {u:0, d:0, l:0, r:0, tl:0, tr:0, f:0};
let aimScreen = null, mouseAim = false;
let callsign = '';

/* ---------------- ユーティリティ ---------------- */
const r0 = v => Math.round(v), r1 = v => Math.round(v * 10) / 10, r2 = v => Math.round(v * 100) / 100;
function normalizeAngle(a) { return a - Math.PI * 2 * Math.round(a / (Math.PI * 2)); }
function cleanName(s) { return String(s || '').replace(/[<>&"'`]/g, '').trim().slice(0, 12) || 'Player'; }
function toast(msg) {
  const t = $('toast'); t.textContent = msg; t.classList.add('show');
  clearTimeout(toast._t); toast._t = setTimeout(() => t.classList.remove('show'), 2600);
}
const SCREENS = ['menuScreen', 'soloScreen', 'onlineScreen', 'lobbyScreen', 'resultScreen'];
function showScreen(id) { SCREENS.forEach(s => $(s).style.display = (s === id ? 'flex' : 'none')); }
const _hud = {};
function setText(id, v) { if (_hud[id] !== v) { _hud[id] = v; $(id).textContent = v; } }
function slotTeam(id) { return id[0] === 'A' ? 0 : 1; }

function loadName() { try { return localStorage.getItem('wtk_name') || ''; } catch (e) { return ''; } }
function saveName(n) { try { localStorage.setItem('wtk_name', n); } catch (e) {} }

/* ---------------- 当たり判定・視線 ---------------- */
function collides(x, y, r) {
  if (x - r < 0 || x + r > MAP_WIDTH || y - r < 0 || y + r > MAP_HEIGHT) return true;
  for (const o of obstacles) if (x + r > o.x && x - r < o.x + o.w && y + r > o.y && y - r < o.y + o.h) return true;
  return false;
}
function segHitsRect(x1, y1, x2, y2, r) {
  let t0 = 0, t1 = 1; const dx = x2 - x1, dy = y2 - y1;
  const p = [-dx, dx, -dy, dy], q = [x1 - r.x, r.x + r.w - x1, y1 - r.y, r.y + r.h - y1];
  for (let i = 0; i < 4; i++) {
    if (p[i] === 0) { if (q[i] < 0) return false; }
    else {
      const t = q[i] / p[i];
      if (p[i] < 0) { if (t > t1) return false; if (t > t0) t0 = t; }
      else { if (t < t0) return false; if (t < t1) t1 = t; }
    }
  }
  return true;
}
function segNearCircle(x1, y1, x2, y2, cx, cy, r) {
  const dx = x2 - x1, dy = y2 - y1, l2 = dx * dx + dy * dy;
  let t = l2 ? ((cx - x1) * dx + (cy - y1) * dy) / l2 : 0;
  t = Math.max(0, Math.min(1, t));
  return Math.hypot(x1 + dx * t - cx, y1 + dy * t - cy) < r;
}
function hasLOS(x1, y1, x2, y2) {
  for (const s of smokes) if (segNearCircle(x1, y1, x2, y2, s.x, s.y, s.radius)) return false;
  for (const o of obstacles) if (segHitsRect(x1, y1, x2, y2, o)) return false;
  return true;
}
function rayBlocked(x, y, angle, dist) {
  const cx = x + Math.cos(angle) * dist, cy = y + Math.sin(angle) * dist;
  if (cx < 30 || cx > MAP_WIDTH - 30 || cy < 30 || cy > MAP_HEIGHT - 30) return true;
  return collides(cx, cy, 15);
}

/* =====================================================================
   シミュレーション(ソロ/ホストのみで実行)
   ===================================================================== */
function genDecor() {
  const d = [];
  for (let i = 0; i < 60; i++) d.push([
    r0(Math.random() * MAP_WIDTH),
    r0(Math.random() > 0.5 ? Math.random() * 200 : MAP_HEIGHT - 200 + Math.random() * 200),
    r0(Math.random() * 32 + 14), Math.random() > 0.3 ? 0 : 1
  ]);
  return d;
}
function createTank(slotId) {
  const team = slotTeam(slotId), idx = +slotId[1];
  const d = VEHICLE_DATA[TEAM_FACTION[team]][idx];
