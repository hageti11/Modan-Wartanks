  </div>

  <!-- ソロ: 陣営→車両 -->
  <div id="soloScreen" class="screen">
    <h1 id="soloTitle">[ 陣営選択 ]</h1>
    <div class="row" id="soloList"></div>
    <button class="select-btn ghost" id="soloBack">戻る</button>
  </div>

  <!-- オンライン入口 -->
  <div id="onlineScreen" class="screen">
    <h1>[ オンライン対戦 ]</h1>
    <div class="row"><button class="select-btn primary" id="btnCreate">ルームを作る(ホスト)</button></div>
    <div class="row">
      <input type="text" id="codeInput" maxlength="5" placeholder="コード">
      <button class="select-btn primary" id="btnJoin">ルームに参加</button>
    </div>
    <div class="msg" id="onlineMsg"></div>
    <div class="help">ホストが作ったルームコード(5文字)を友達に伝えると、同じルームに入れます。<br>ホストの端末が試合を動かすので、ホストは試合中この画面を開いたままにしてください。</div>
    <button class="select-btn ghost" id="onlineBack">戻る</button>
  </div>

  <!-- ロビー -->
  <div id="lobbyScreen" class="screen">
    <div id="roomBar">
      <span>ルームコード</span><span id="roomCodeText">-----</span>
      <button class="select-btn ghost" id="copyLinkBtn" style="padding:0.5rem 1rem">招待リンクをコピー</button>
    </div>
    <div class="sub" id="lobbyPlayers"></div>
    <div id="slotWrap"></div>
    <div class="help" id="lobbyHint"></div>
    <div class="row">
      <button class="select-btn primary" id="startBtn">出撃開始</button>
      <button class="select-btn ghost" id="lobbyLeave">退出</button>
    </div>
  </div>

  <!-- リザルト -->
  <div id="resultScreen" class="screen">
    <div id="resultTitle">VICTORY</div>
    <div class="row">
      <button class="select-btn primary" id="resultMain">ロビーに戻る</button>
      <button class="select-btn ghost" id="resultMenu">メニューへ</button>
    </div>
  </div>

  <!-- 操作 UI -->
  <div class="controls">
    <div class="btn-pad">
      <div></div><div class="btn" id="up">前</div><div></div>
      <div class="btn" id="left">左</div><div></div><div class="btn" id="right">右</div>
      <div></div><div class="btn" id="down">後</div><div></div>
    </div>
    <div class="action-group">
      <div class="btn" id="turretLeft">砲←</div>
      <div class="btn" id="turretRight">砲→</div>
      <div class="btn" id="smokeBtn">煙幕</div>
      <div class="btn" id="airBtn">航空<br>支援</div>
      <div class="btn" id="switchBtn">武装<br>切替</div>
      <div class="btn" id="fireBtn">射撃</div>
    </div>
  </div>
  <div id="toast"></div>
</div>

<script src="https://cdn.jsdelivr.net/npm/peerjs@1.5.4/dist/peerjs.min.js"></script>
<script>
'use strict';
/* =====================================================================
   Modern Wartanks 2D Online
   - ソロ(AI戦) / オンライン(P2P: ホストが試合を計算、ゲストは入力を送信)
   - 通信は PeerJS(WebRTC)。専用サーバーは不要です。
   ===================================================================== */
const $ = id => document.getElementById(id);
const canvas = $('gameCanvas'), ctx = canvas.getContext('2d');
const miniCanvas = $('minimapCanvas'), mctx = miniCanvas.getContext('2d');
const MAP_WIDTH = 5000, MAP_HEIGHT = 1500;
const VIEW_W = 1600, VIEW_H = 800;
canvas.width = VIEW_W; canvas.height = VIEW_H;
const STEP = 1000 / 60;
const PEER_PREFIX = 'wtk2d-';

const VEHICLE_DATA = {
  US_JP: [
    {id:'type90', name:'90式戦車', topSpeed:68, revSpeed:32, accel:0.12, armor:{front:720, side:220, rear:80}, hp:155, color:'#324232', contourType:'type90', era:false, weapons:[
