  m.T.forEach((a, i) => {
    const t = tanks[i]; if (!t) return;
    t.nx = a[0]; t.ny = a[1]; t.nba = a[2]; t.nta = a[3];
    t.hp = a[4]; t.cooldown = a[5]; t.wi = a[6]; t.currentSpeed = a[7]; t.smokeCD = a[8]; t.airCD = a[9];
  });
