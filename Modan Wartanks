  tanks = []; showScreen('lobbyScreen'); renderLobby(); broadcastLobby();
}

/* --- ゲスト --- */
function joinRoom(raw) {
  const code = String(raw || '').toUpperCase().replace(/[^A-Z0-9]/g, '');
  if (code.length < 4) { setOnlineMsg('ルームコードを入力してください'); return; }
  if (typeof Peer === 'undefined') { setOnlineMsg('通信ライブラリを読み込めませんでした。ネット接続を確認して再読み込みしてください。'); return; }
  cleanupNet(); mode = 'client'; roomCode = code; setOnlineMsg('接続中…');
  let welcomed = false;
  const fail = msg => { if (welcomed) return; clearTimeout(timer); setOnlineMsg(msg); cleanupNet(); mode = 'menu'; };
  const timer = setTimeout(() => fail('接続がタイムアウトしました。コードを確認して、もう一度お試しください'), 15000);
  const p = new Peer(); peer = p;
  p.on('open', () => {
    const c = p.connect(PEER_PREFIX + code, {reliable:true, serialization:'json'}); hostConn = c;
    c.on('data', m => {
      if (m && m.t === 'welcome') { welcomed = true; clearTimeout(timer); }
      try { onClientMsg(m); } catch (e) { console.error(e); }
    });
    c.on('close', () => { if (welcomed && !leaving) hostLost(); });
    c.on('error', () => { if (welcomed && !leaving) hostLost(); });
  });
  p.on('error', e => {
    if (welcomed) { if (!leaving) hostLost(); return; }
    fail(e.type === 'peer-unavailable' ? 'ルームが見つかりません(コードを確認してください)' : '通信エラー: ' + e.type);
  });
}
function hostLost() {
  clearInterval(netTimer); inGame = false; mode = 'menu';
  document.body.classList.remove('ingame');
  showResultScreen('ホストとの接続が切れました', '#f87171', false);
}
