}
function sanitizeInput(k) {
  k = k || {};
  return {u:!!k.u, d:!!k.d, l:!!k.l, r:!!k.r, tl:!!k.tl, tr:!!k.tr, f:!!k.f, a:(typeof k.a === 'number' && isFinite(k.a)) ? k.a : null};
