  <!-- メニュー -->
  <div id="menuScreen" class="screen">
    <h1>[ Modern Wartanks 2D Online ]</h1>
    <p class="sub">現代戦車 4 対 4 ・ AI 戦 / オンライン協力・対戦</p>
    <div class="row"><input type="text" id="nameInput" maxlength="12" placeholder="コールサイン(名前)"></div>
    <div class="row">
      <button class="select-btn primary" id="btnSolo">ソロ出撃<br><small>(AI 部隊と戦う)</small></button>
      <button class="select-btn primary" id="btnOnline">オンライン対戦<br><small>(友達とルームで遊ぶ)</small></button>
