/* =====================================================================
   ゲーム進行・描画
   ===================================================================== */
let lastTs = 0, acc = 0, netTick = 0;
function enterGame() {
  inGame = true; resultShown = false; document.body.classList.add('ingame'); showScreen(null);
  lastTs = performance.now(); acc = 0; snapT = performance.now();
  for (const k in keys) keys[k] = 0;
  try { if (navigator.wakeLock) navigator.wakeLock.request('screen').catch(() => {}); } catch (e) {}
  clearInterval(netTimer); netCount = 0;
  if (mode === 'client') {
    netTimer = setInterval(() => {
      if (!inGame || !hostConn || !hostConn.open) return;
      hostConn.send({t:'in', k:buildInput()});
      if (++netCount % 40 === 0) hostConn.send({t:'ping', ts:Date.now()});
    }, 50);
  }
  const me = myTank();
  if (me) {
    setText('tankName', me.name);
    setText('armorVal', me.armor.front + '/' + me.armor.side + '/' + me.armor.rear);
  } else { setText('tankName', '観戦中'); setText('armorVal', '-'); }
}
function scheduleResult() {
  clearTimeout(overTimer);
  overTimer = setTimeout(() => {
    if (resultShown) return; resultShown = true;
    const me = myTank(), myTeam = me ? me.team : 0;
    let title, color;
    if (over.w === -1) { title = 'DRAW (相討ち)'; color = '#facc15'; }
    else if (over.w === myTeam) { title = 'VICTORY (作戦成功・敵殲滅)'; color = '#4ade80'; }
    else { title = 'DEFEAT (作戦失敗・自部隊壊滅)'; color = '#f87171'; }
    showResultScreen(title, color, true);
  }, 1800);
}
function showResultScreen(title, color, canMain) {
  $('resultTitle').textContent = title; $('resultTitle').style.color = color;
  const main = $('resultMain');
  if (mode === 'host') { main.style.display = ''; main.textContent = 'ロビーに戻る'; }
  else if (mode === 'solo') { main.style.display = ''; main.textContent = '作戦再出撃'; }
  else if (mode === 'client' && canMain) { main.style.display = 'none'; $('resultTitle').textContent = title + '\n(ホストの操作待ち)'; $('resultTitle').style.whiteSpace = 'pre-line'; }
  else main.style.display = 'none';
  showScreen('resultScreen');
}

function frame(ts) {
  requestAnimationFrame(frame);
  if (!inGame || !tanks.length) return;
  const dt = Math.min(100, ts - lastTs); lastTs = ts;
  const fr = dt / STEP;
  if (mode !== 'client') {
    const me = myTank(); if (me && me.hp > 0) me.input = buildInput();
    acc += dt; let n = 0;
    while (acc >= STEP && n < 6) {
      simStep(); drainEvents(); acc -= STEP; n++;
      if ((++netTick % 2) === 0 && Object.keys(guests).length) broadcast(buildSnap());
    }
    if (n === 6) acc = 0;
  } else {
    for (const t of tanks) {
      t.x += (t.nx - t.x) * 0.4; t.y += (t.ny - t.y) * 0.4;
      t.bodyAngle += normalizeAngle(t.nba - t.bodyAngle) * 0.4;
      t.turretAngle += normalizeAngle(t.nta - t.turretAngle) * 0.4;
    }
    for (let i = smokes.length - 1; i >= 0; i--) { smokes[i].life -= fr; if (smokes[i].life <= 0) smokes.splice(i, 1); }
  }
  render(fr);
}

function render(fr) {
  const me = viewTank(); if (!me) return;
  const mine = myTank(), myTeam = mine ? mine.team : 0;
  ctx.clearRect(0, 0, VIEW_W, VIEW_H);
  camX = Math.min(0, Math.max(VIEW_W - MAP_WIDTH, VIEW_W / 2 - me.x));
  camY = Math.min(0, Math.max(VIEW_H - MAP_HEIGHT, VIEW_H / 2 - me.y));
  ctx.save(); ctx.translate(camX, camY);

  ctx.fillStyle = '#141e12'; ctx.fillRect(0, 0, MAP_WIDTH, MAP_HEIGHT);
  ctx.strokeStyle = '#1b2818'; ctx.lineWidth = 2;
  const gx0 = Math.floor(-camX / 120) * 120, gy0 = Math.floor(-camY / 120) * 120;
  for (let x = gx0; x <= -camX + VIEW_W; x += 120) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, MAP_HEIGHT); ctx.stroke(); }
  for (let y = gy0; y <= -camY + VIEW_H; y += 120) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(MAP_WIDTH, y); ctx.stroke(); }
  ctx.strokeStyle = '#3d5a3a'; ctx.lineWidth = 6; ctx.strokeRect(0, 0, MAP_WIDTH, MAP_HEIGHT);

  for (const n of decor) {
    ctx.fillStyle = n[3] === 0 ? '#0d180d' : '#2b2620';
    ctx.beginPath(); ctx.arc(n[0], n[1], n[2], 0, Math.PI * 2); ctx.fill();
    ctx.fillStyle = n[3] === 0 ? '#162b16' : '#3d362e';
    ctx.beginPath(); ctx.arc(n[0] - 4, n[1] - 4, n[2] * 0.6, 0, Math.PI * 2); ctx.fill();
    ctx.strokeStyle = '#080e08'; ctx.lineWidth = 2; ctx.stroke();
  }
  for (const o of obstacles) {
    ctx.fillStyle = '#3a3124'; ctx.fillRect(o.x, o.y, o.w, o.h);
    ctx.fillStyle = '#4a3f30'; ctx.fillRect(o.x + 8, o.y + 8, o.w - 16, o.h - 16);
    ctx.strokeStyle = '#201a12'; ctx.lineWidth = 4; ctx.strokeRect(o.x, o.y, o.w, o.h);
    ctx.strokeStyle = '#18130d'; ctx.lineWidth = 2; ctx.beginPath();
    ctx.moveTo(o.x + 20, o.y + 20); ctx.lineTo(o.x + o.w - 20, o.y + o.h - 20);
    ctx.moveTo(o.x + o.w - 20, o.y + 20); ctx.lineTo(o.x + 20, o.y + o.h - 20); ctx.stroke();
  }

  for (const t of tanks) if (t.hp <= 0) drawTank(t, true);
  for (const t of tanks) if (t.hp > 0) { drawTank(t, false); drawNameTagAndBar(t, mine, myTeam); }

  ctx.fillStyle = 'rgba(200, 205, 200, 0.55)';
  for (const s of smokes) { ctx.beginPath(); ctx.arc(s.x, s.y, s.radius, 0, Math.PI * 2); ctx.fill(); }

  const k = (mode === 'client') ? Math.min(3, (performance.now() - snapT) / STEP) : 0;
  for (const b of bullets) drawBullet(b, k);
  for (const a of air) drawHeli(a);

  for (let i = particles.length - 1; i >= 0; i--) {
    const p = particles[i];
    ctx.fillStyle = p.color; ctx.beginPath(); ctx.arc(p.x, p.y, Math.max(0.1, p.size), 0, Math.PI * 2); ctx.fill();
    p.x += p.vx * fr; p.y += p.vy * fr; p.size *= Math.pow(0.93, fr); p.life -= fr;
    if (p.life <= 0) particles.splice(i, 1);
  }
  ctx.font = 'bold 15px sans-serif'; ctx.textAlign = 'center';
  for (let i = popups.length - 1; i >= 0; i--) {
    const p = popups[i];
    ctx.fillStyle = '#000'; ctx.fillText(p.text, p.x + 1, p.y + 1);
    ctx.fillStyle = p.color; ctx.fillText(p.text, p.x, p.y);
    p.y -= 0.5 * fr; p.life -= fr;
    if (p.life <= 0) popups.splice(i, 1);
  }
  ctx.restore();

  drawMinimap(mine, myTeam);
  updateHud(mine, myTeam);
}

function updateHud(mine, myTeam) {
  let ally = 0, enemy = 0;
  for (const t of tanks) if (t.hp > 0) { if (t.team === myTeam) ally++; else enemy++; }
  setText('allyCount', String(ally)); setText('count', String(enemy));
  if (mine) {
    setText('tankName', mine.name);
    setText('weaponName', mine.weapons[mine.wi].name);
    setText('hp', String(Math.max(0, Math.ceil(mine.hp))));
    setText('smokeCD', mine.smokeCD <= 0 ? 'OK' : Math.ceil(mine.smokeCD / 60) + 's');
    setText('airCD', mine.airCD <= 0 ? 'OK' : Math.ceil(mine.airCD / 60) + 's');
  } else { setText('tankName', '観戦中'); setText('weaponName', '-'); setText('hp', '-'); }
  if (mode === 'host' || mode === 'client') {
    const humans = tanks.filter(t => t.human).length;
    setText('netInfo', 'ルーム ' + roomCode + ' | 人間 ' + humans + '人' + (mode === 'client' ? ' | Ping ' + pingMs + 'ms' : ' | ホスト'));
  } else setText('netInfo', '');
}

function drawMinimap(mine, myTeam) {
  mctx.clearRect(0, 0, miniCanvas.width, miniCanvas.height);
  const sx = miniCanvas.width / MAP_WIDTH, sy = miniCanvas.height / MAP_HEIGHT;
  mctx.fillStyle = '#3a3124';
  for (const o of obstacles) mctx.fillRect(o.x * sx, o.y * sy, o.w * sx, o.h * sy);
  for (const t of tanks) {
    if (t.hp <= 0) continue;
    mctx.fillStyle = t === mine ? '#4ade80' : (t.team === myTeam ? '#38bdf8' : '#f87171');
    mctx.beginPath(); mctx.arc(t.x * sx, t.y * sy, t === mine ? 5 : 3.4, 0, Math.PI * 2); mctx.fill();
  }
  mctx.strokeStyle = 'rgba(255,255,255,0.4)'; mctx.lineWidth = 1;
  mctx.strokeRect(-camX * sx, -camY * sy, VIEW_W * sx, VIEW_H * sy);
}

function drawNameTagAndBar(t, mine, myTeam) {
  ctx.save(); ctx.font = 'bold 13px sans-serif'; ctx.textAlign = 'center';
  const isMe = t === mine, ally = t.team === myTeam;
  const color = isMe ? '#4ade80' : (ally ? '#38bdf8' : '#f87171');
  const tag = isMe ? '[自機] ' : (ally ? '[味方] ' : '[敵] ');
  const label = tag + (t.human ? t.pname + ' / ' : '') + t.name;
  ctx.fillStyle = '#000'; ctx.fillText(label, t.x + 1, t.y - 41);
  ctx.fillStyle = color; ctx.fillText(label, t.x, t.y - 42);
  ctx.fillStyle = '#18181b'; ctx.fillRect(t.x - 22, t.y - 36, 44, 4);
  ctx.fillStyle = color; ctx.fillRect(t.x - 22, t.y - 36, (Math.max(0, t.hp) / t.maxHp) * 44, 4);
  const rl = t.weapons[t.wi].reload, prog = Math.max(0, Math.min(1, 1 - t.cooldown / rl));
  ctx.fillStyle = '#18181b'; ctx.fillRect(t.x - 22, t.y - 30, 44, 2);
  ctx.fillStyle = prog >= 1 ? '#4ade80' : '#facc15'; ctx.fillRect(t.x - 22, t.y - 30, 44 * prog, 2);
  ctx.restore();
}

function drawBullet(b, k) {
  ctx.save(); ctx.translate(b.x + b.vx * k, b.y + b.vy * k); ctx.rotate(Math.atan2(b.vy, b.vx));
  if (b.type === 'tow') {
    ctx.fillStyle = '#ff3b00'; ctx.fillRect(-10, -2.5, 20, 5);
    ctx.fillStyle = '#ffffff'; ctx.beginPath(); ctx.moveTo(-10, -5); ctx.lineTo(-4, 0); ctx.lineTo(-10, 5); ctx.fill();
  } else if (b.type === 'heat') {
    ctx.fillStyle = '#ffaa00'; ctx.beginPath(); ctx.moveTo(8, 0); ctx.lineTo(-2, -5); ctx.lineTo(-2, 5); ctx.closePath(); ctx.fill();
    ctx.fillStyle = '#b36b00'; ctx.fillRect(-8, -3, 6, 6);
  } else {
    ctx.fillStyle = b.type === 'apds' ? '#ffffff' : '#fef08a'; ctx.fillRect(-9, -1, 18, 2);
    ctx.fillStyle = '#ef4444'; ctx.fillRect(-9, -2, 4, 4);
  }
  ctx.restore();
}

function drawHeli(a) {
  ctx.save(); ctx.translate(a.x, a.y);
  ctx.fillStyle = 'rgba(0,0,0,0.25)'; ctx.beginPath(); ctx.ellipse(0, 46, 40, 10, 0, 0, Math.PI * 2); ctx.fill();
  ctx.scale(a.dir, 1);
  ctx.fillStyle = a.team === 0 ? '#1e293b' : '#27272a'; ctx.fillRect(-38, -10, 76, 20);
  ctx.fillStyle = '#09090b'; ctx.fillRect(-70, -6, 34, 8); ctx.fillRect(-70, -14, 4, 20);
  ctx.fillStyle = '#334155'; ctx.fillRect(18, -7, 16, 14);
  ctx.strokeStyle = 'rgba(220,220,220,0.65)'; ctx.lineWidth = 3;
  const ra = a.t * 0.9;
  for (let i = 0; i < 2; i++) {
    const ang = ra + i * Math.PI / 2;
    ctx.beginPath(); ctx.moveTo(Math.cos(ang) * 46, Math.sin(ang) * 46); ctx.lineTo(-Math.cos(ang) * 46, -Math.sin(ang) * 46); ctx.stroke();
  }
  ctx.restore();
}

function drawTank(t, wreck) {
  ctx.save(); ctx.translate(t.x, t.y);
  if (wreck) ctx.globalAlpha = 0.35;
  ctx.save(); ctx.rotate(t.bodyAngle);
  ctx.fillStyle = '#111113'; ctx.fillRect(-28, -21, 56, 7); ctx.fillRect(-28, 14, 56, 7);
  ctx.fillStyle = '#27272a';
  for (let wx = -22; wx <= 22; wx += 6) { ctx.fillRect(wx, -20, 4, 5); ctx.fillRect(wx, 15, 4, 5); }
  ctx.fillStyle = wreck ? '#2a2a2a' : t.color;
  if (t.contourType === 'type10') {
    ctx.beginPath(); ctx.moveTo(24, 0); ctx.lineTo(16, -15); ctx.lineTo(-24, -15); ctx.lineTo(-24, 15); ctx.lineTo(16, 15); ctx.closePath(); ctx.fill();
  } else if (t.contourType === 'type90') {
    ctx.fillRect(-24, -16, 48, 32);
  } else if (t.contourType === 'm1a2') {
    ctx.beginPath(); ctx.moveTo(28, 0); ctx.lineTo(18, -17); ctx.lineTo(-26, -17); ctx.lineTo(-26, 17); ctx.lineTo(18, 17); ctx.closePath(); ctx.fill();
  } else if (t.contourType === 'bradley' || t.contourType === 'ztl11') {
    ctx.fillRect(-25, -13, 50, 26);
  } else {
    ctx.beginPath(); ctx.moveTo(26, -5); ctx.lineTo(26, 5); ctx.lineTo(18, 15); ctx.lineTo(-24, 15); ctx.lineTo(-24, -15); ctx.lineTo(18, -15); ctx.closePath(); ctx.fill();
  }
  if (t.era) {
    ctx.fillStyle = '#1e293b';
    for (let i = -20; i <= 16; i += 5) { ctx.fillRect(i, -17, 4, 3); ctx.fillRect(i, 14, 4, 3); }
  }
  ctx.fillStyle = '#0f172a'; ctx.fillRect(-12, -9, 14, 18);
  ctx.restore();

  ctx.save(); ctx.rotate(t.turretAngle);
  ctx.fillStyle = '#09090b'; ctx.fillRect(2, -4, 42, 8);
  ctx.fillStyle = '#18181b'; ctx.fillRect(20, -5.5, 7, 11);
  ctx.fillStyle = '#27272a'; ctx.fillRect(40, -4.5, 4, 9);
  ctx.fillStyle = wreck ? '#333' : t.color;
  ctx.beginPath();
  if (t.contourType === 'm1a2') { ctx.moveTo(-12, -14); ctx.lineTo(12, -11); ctx.lineTo(22, 0); ctx.lineTo(12, 11); ctx.lineTo(-12, 14); }
  else { ctx.moveTo(-18, -13); ctx.lineTo(10, -11); ctx.lineTo(20, 0); ctx.lineTo(10, 11); ctx.lineTo(-18, 13); }
  ctx.closePath(); ctx.fill();
  ctx.strokeStyle = '#050507'; ctx.lineWidth = 1.5; ctx.stroke();
  ctx.fillStyle = '#1c1917'; ctx.fillRect(-24, -10, 9, 20);
  ctx.fillStyle = '#52525b';
  ctx.fillRect(-8, -16, 4, 3); ctx.fillRect(-3, -16, 4, 3); ctx.fillRect(-8, 13, 4, 3); ctx.fillRect(-3, 13, 4, 3);
  ctx.fillStyle = '#18181b'; ctx.fillRect(-5, -5, 10, 10);
  ctx.fillStyle = '#3f3f46'; ctx.fillRect(3, -2, 12, 4);
  ctx.restore();
  ctx.restore();
}

