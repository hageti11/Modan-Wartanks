    case 'welcome': myPid = m.pid; hostConn.send({t:'hello', n:callsign}); break;
    case 'full': setOnlineMsg(m.r || '参加できません'); mode = 'menu'; cleanupNet(); break;
    case 'lobby':
      lobby.slots = m.slots; lobby.names = m.names; roomCode = m.code || roomCode;
      $('roomCodeText').textContent = roomCode;
      if (inGame || resultShown || $('onlineScreen').style.display === 'flex' || $('resultScreen').style.display === 'flex') {
        inGame = false; resultShown = false; document.body.classList.remove('ingame'); clearInterval(netTimer);
      }
      showScreen('lobbyScreen'); renderLobby(); break;
    case 'start':
      lobby.slots = m.slots; lobby.names = m.names; decor = m.decor; initSim(); enterGame(); break;
    case 's': applySnapshot(m); break;
    case 'pong': pingMs = Date.now() - m.ts; break;
